DB_PASSWORD=
DB_NAME=corazon_artesano
JWT_SECRET=corazon-artesano-secret
PORT=3001

# Configuración de Origen del Frontend (Localhost y Vercel)
FRONTEND_URL=http://localhost:5173
VERCEL_FRONTEND_URL=https://corazonartesano.vercel.app

# Configuración de Envío Real de Correo Electrónico (Gmail / SMTP)
# Para Gmail, genera una contraseña de aplicación en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion_gmail
SMTP_FROM="Corazón Artesano" <tucorreo@gmail.com>

# Aliases compatibles con mailer.js
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=tucorreo@gmail.com
MAIL_PASS=tu_clave_de_aplicacion_gmail
MAIL_FROM="Corazón Artesano" <tucorreo@gmail.com>

# URLs de servicios
